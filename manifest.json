{
  "manifest_version": 3,
  "name": "Job Details Extractor",
  "version": "1.0",
  "description": "Extracts job number and customer details from the current page.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
  "https://go.servicetitan.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
